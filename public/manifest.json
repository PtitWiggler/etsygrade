{
  "manifest_version": 3,
  "name": "EtsyGrade",
  "version": "0.1.0",
  "description": "Extension permettant d'obtenir la notation d'une fiche Etsy et des conseils d'amélioration",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.etsy.com/listing/*"],
      "js": ["content/scraper.js"]
    }
  ],
  "permissions": [
    "activeTab",
    "tabs"
  ]
}